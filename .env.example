# Use two distinct active keys for the same provider/model.
LLM_API_KEYS=replace-with-first-key,replace-with-second-key
LLM_MODEL=openai/gpt-4o-mini
# Leave empty for the provider default. For compatible services, include /v1.
LLM_API_BASE=
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
VITE_API_URL=http://localhost:8000
# Use local model metadata so startup does not depend on fetching the price map.
LITELLM_LOCAL_MODEL_COST_MAP=True
